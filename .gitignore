target/
buck-out/
/third-party/overrides/
/fixups
# Ignore generated bundle output but keep the static packaging
# tree under /dist/macos/ checked in (Info.plist + build_app.sh
# drive the Finder integration). Anchor to the repo root so the
# pattern doesn't also swallow `crates/hxy/dist/` (wasm build
# artifacts), and use `/dist/*` instead of `/dist/` so gitignore
# still recurses into subdirectories beneath.
/dist/*
!/dist/macos/
# Wasm build output (wasm-pack / trunk) lives under `crates/hxy/dist/`.
crates/hxy/dist/
.claude/
.direnv/
.DS_Store
*.log
*.json.gz

# cargo-fuzz: build outputs are reproducible, coverage profiles are
# large. Seed corpus under fuzz/corpus/<target>/ IS tracked -- once
# it grows past the seed set, minimize with `cargo fuzz cmin` and
# commit the trimmed result. `fuzz/artifacts/` holds reproducer
# inputs for discovered crashes; committing those is fine too, but
# our runs are currently clean.
fuzz/target/
fuzz/coverage/

# Cloned at runtime by the application (and at test time by
# `scripts/fetch_imhex_patterns.sh`) to provide ImHex's GPL-licensed
# pattern corpus + `std/` library. Kept out of the source tree on
# purpose -- we link to it but do not redistribute it.
.imhex-patterns/
