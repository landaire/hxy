load("@prelude//platforms:defs.bzl", "host_configuration")
load(":defs.bzl", "cached_execution_platform", "remote_cache_configured")

# Cross-compilation target platform for the wasm plugin components.
# Building a plugin under this platform compiles it (and its whole
# dependency subgraph) for wasm32-wasip2; a cdylib emits a component
# directly. Execution stays on the host (prelude//platforms:default via
# [build] execution_platforms), so dependency build scripts and proc
# macros run natively while the crate compiles for wasm.
#
# Use it with `--target-platforms=//platforms:wasm32-wasip2`.
platform(
    name = "wasm32-wasip2",
    constraint_values = [
        "prelude//os/constraints:wasi",
        "prelude//cpu/constraints:wasm32",
    ],
    visibility = ["PUBLIC"],
)

# `[build] execution_platforms` of CI jobs that reach the shared action
# cache (.github/workflows/rust.yml).
cached_execution_platform(
    name = "cached",
    cpu_configuration = host_configuration.cpu,
    host_tools = read_root_config("ci", "host_tools"),
    os_configuration = host_configuration.os,
    remote_cache_enabled = remote_cache_configured(),
    use_windows_path_separators = host_info().os.is_windows,
    visibility = ["PUBLIC"],
)
